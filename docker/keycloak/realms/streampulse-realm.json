{
  "id": "streampulse",
  "realm": "streampulse",
  "displayName": "StreamPulse (see docs/adr/0011-keycloak-for-local-oidc.md)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,

  "clients": [
    {
      "clientId": "ingest-gateway",
      "description": "Machine-to-machine client for the ingest gateway. client_credentials only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ingest-gateway-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "streamflix",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "ingest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "streampulse-ingest",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "analytics-dashboard",
      "description": "Read-only analytics client. Same realm, same signing key, DIFFERENT audience — the control case that proves ingest checks aud.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "analytics-dashboard-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "streamflix",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "analytics-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "streampulse-analytics",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "streampulse-web",
      "description": "Browser dashboard (web/). Public client: authorization code + PKCE S256, no secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ]
}
