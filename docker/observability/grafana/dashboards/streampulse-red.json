{
  "id": null,
  "uid": "streampulse-red",
  "title": "StreamPulse RED per service",
  "description": "Rate, Errors, Duration for every service's HTTP endpoints, from http_server_requests_seconds. Actuator probes are excluded. Pipeline resources are in the JVM dashboard (USE).",
  "tags": [
    "streampulse",
    "red"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "streampulse-prometheus"
        },
        "definition": "label_values(http_server_requests_seconds_count, job)",
        "query": {
          "query": "label_values(http_server_requests_seconds_count, job)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate: requests/s",
      "description": "Requests per second by service, health and metrics endpoints excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rate: requests/s by status",
      "description": "Which responses the services are returning.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum by (job, status) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{status}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors: 5xx ratio",
      "description": "5xx over non-4xx requests, per service: the same definition as the ingest SLI. 4xx are the caller's problem and are not errors here.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "(sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\"/actuator.*\",status!~\"4..\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errors: 4xx ratio",
      "description": "4xx over all requests: 401 and 403 point at a token or tenant problem, 429 at a tenant over quota, 400 at a client bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "(sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\"/actuator.*\",status=~\"4..\"}[$__rate_interval])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duration: mean latency",
      "description": "sum / count. The mean hides the tail: use p99 where a histogram exists.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum by (job) (rate(http_server_requests_seconds_sum{job=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Duration: p99 latency",
      "description": "Only services that publish the bucket series appear (ingest-gateway today: percentiles-histogram is enabled for http.server.requests in its application.yml only). Empty for the others is expected, not a fault.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Duration: slowest recent request",
      "description": "http_server_requests_seconds_max: the worst request in the last scrape windows, decaying.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "max by (job) (http_server_requests_seconds_max{job=~\"$service\",uri!~\"/actuator.*\"})",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
