    {
      "id": 5,
      "type": "stat",
      "title": "Budget left, 30d",
      "description": "1 minus the share of the 30-day budget spent. Prometheus retention in the local stack is shorter than 30 days, so this covers only the data it holds.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_requests_seconds_count{job=\"ingest-gateway\",uri=\"/v1/events:batch\",status=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_requests_seconds_count{job=\"ingest-gateway\",uri=\"/v1/events:batch\",status!~\"4..\"}[30d]))) / 0.001",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
