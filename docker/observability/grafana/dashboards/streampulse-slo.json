{
  "id": null,
  "uid": "streampulse-slo",
  "title": "StreamPulse SLOs and error budgets",
  "description": "The two SLOs, their burn rates and the alerts they feed. Reads the recording rules in docker/observability/rules, so it needs the compose.obs.yml override. Every target is a target until Phase 9 measures it.",
  "tags": [
    "streampulse",
    "slo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
