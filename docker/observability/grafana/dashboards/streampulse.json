    {
      "id": 6,
      "type": "timeseries",
      "title": "Consumer lag (records, max per partition)",
      "description": "kafka_consumer_fetch_manager_records_lag_max: the largest per-partition backlog in the sampling window, measured against the fetch position, not the committed offset. Restore consumers replay changelogs after a restart and are excluded. Diagnose before scaling (see docs/runbook.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "max by (job) (kafka_consumer_fetch_manager_records_lag_max{job=~\"sink-writer|stream-processor\",client_id!~\".*restore-consumer.*\"})",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Processor: rejected and duplicate events/s",
      "description": "Rejected events were dead-lettered to telemetry.raw.v1.dlt, by reason. Duplicates were dropped by eventId, which is healthy (a client retried).",
      "datasource": {
        "type": "prometheus",
