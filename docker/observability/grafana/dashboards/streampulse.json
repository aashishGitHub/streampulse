      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum by (reason) (rate(streampulse_processor_events_rejected_events_total[1m]))",
          "legendFormat": "rejected: {{reason}}",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum(rate(streampulse_processor_events_duplicates_events_total[1m]))",
