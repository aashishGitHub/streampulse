    {
      "id": 11,
      "type": "timeseries",
      "title": "Sink dead letters and failures",
      "description": "Dead letters are poison records parked on telemetry.agg.v1.dlt: expected to be zero, because records are validated upstream. Flush failures are failed writes to Postgres (a whole batch or a single record); projection failures are batches stored in Postgres whose Redis update failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum(rate(streampulse_sink_dead_letters_records_total[1m]))",
          "legendFormat": "dead letters",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum(rate(streampulse_sink_batch_flush_failures_total[1m]))",
          "legendFormat": "flush failures",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "sum(rate(streampulse_sink_projection_failures_total[1m]))",
          "legendFormat": "Redis projection failures",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
