    {
      "id": 10,
      "type": "timeseries",
      "title": "Freshness (window end to durable write)",
      "description": "streampulse_sink_freshness: now minus window end, recorded when the batch is durable in Postgres. The floor is window + grace = 15 s (ADR-0012). Red line: the 28.6 s histogram bucket the SLO uses for its 30 s target.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(streampulse_sink_freshness_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(streampulse_sink_freshness_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
