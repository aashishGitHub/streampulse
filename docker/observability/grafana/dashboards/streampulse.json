    {
      "id": 12,
      "type": "timeseries",
      "title": "Batch-writer queue depth",
      "description": "Records waiting in the sink's bounded buffer (capacity 2000 in the sink-writer's application.yml). A full buffer stops the listener polling, which is how a slow Postgres turns into consumer lag.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "streampulse-prometheus"
          },
          "expr": "max(streampulse_sink_batch_queue_depth_records)",
          "legendFormat": "queue depth",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
