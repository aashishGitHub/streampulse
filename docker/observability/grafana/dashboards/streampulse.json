    {
      "id": 8,
      "type": "timeseries",
      "title": "Consumer rebalances",
      "description": "Rebalances per consumer group member (rate over 5m). A storm of these stalls consumption and shows up as lag.",
      "datasource": {
        "type": "prometheus",
        "uid": "streampulse-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
