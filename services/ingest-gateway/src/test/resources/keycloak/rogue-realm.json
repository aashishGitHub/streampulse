{
  "id": "rogue-idp",
  "realm": "rogue-idp",
  "displayName": "A DIFFERENT issuer — test fixture only, never started by make up-core",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,

  "clients": [
    {
      "clientId": "ingest-gateway",
      "description": "A byte-for-byte copy of the streampulse ingest client. Same client id, same secret, same tenant claim, same streampulse-ingest audience. Only the signing key and iss differ — which is the whole attack.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ingest-gateway-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "streamflix",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "ingest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "streampulse-ingest",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
