<?xml version="1.0" encoding="UTF-8"?>
<!-- stdout is the MCP protocol channel: every log line goes to stderr, which Claude Code shows as server output. -->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
  <logger name="com.streampulse.mcp" level="INFO"/>
  <!-- Spring AI's annotation scanner trips this checker on every start; the message is informational -->
  <logger name="org.springframework.context.support.PostProcessorRegistrationDelegate$BeanPostProcessorChecker" level="ERROR"/>
</configuration>
